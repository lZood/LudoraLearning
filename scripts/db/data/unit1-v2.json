{"lessons":[{"actId":"489de80b-6b2e-4dd8-9ff0-5db090d3623f","skill":"listening","title":"Listening · Numeros","content":{"kind":"lesson","skill":"listening","contentVersion":2,"lives":false,"present":{"title":"Conteo en la pradera","intro":"Sam el apicultor cuenta sus abejas y menas: escucha cada numero antes de forjar tu receta.","theme":"recipe_book","items":[{"conceptId":"vocab.numbers.one","headline":"El primer ingrediente: uno","en":"one","es":"uno","note":"Suena como 'uan'.","icon":"iron"},{"conceptId":"vocab.numbers.two","headline":"Dos menas en la mano","en":"two","es":"dos","note":"Suena como 'tu'.","icon":"iron"},{"conceptId":"vocab.numbers.three","headline":"Tres bloques apilados","en":"three","es":"tres","note":"Saca la lengua: 'zri'.","icon":"iron"},{"conceptId":"vocab.numbers.four_five","headline":"Cuatro y cinco para craftear","en":"four, five","es":"cuatro, cinco","note":"four = 'for', five = 'faiv'.","icon":"iron"},{"conceptId":"vocab.numbers.six_ten","headline":"De seis a diez en el cofre","en":"six ... ten","es":"seis, siete, ocho, nueve, diez","note":"El cofre dorado guarda los grandes.","icon":"gold"}]},"exercises":[{"type":"audio_mc","meta":{"conceptId":"vocab.numbers.one","section":"recognize","difficulty":1,"hint":"Sam levanta un solo dedo."},"audio":"one","prompt":"¿Que numero escuchaste de Sam?","options":["one","two","three"],"correct":0},{"type":"audio_mc","meta":{"conceptId":"vocab.numbers.two","section":"recognize","difficulty":1,"hint":"Suena cortito: 'tu'."},"audio":"two","prompt":"¿Cuantas menas dijo Sam?","options":["two","four","ten"],"correct":0},{"type":"tap_pairs_audio","meta":{"conceptId":"vocab.numbers.three","section":"recognize","difficulty":1.1,"tip":"Une cada sonido con su palabra escrita."},"pairs":[{"audio":"one","word":"one"},{"audio":"two","word":"two"},{"audio":"three","word":"three"}]},{"type":"who_said_it","meta":{"conceptId":"vocab.numbers.four_five","section":"produce","difficulty":1.3,"hint":"'faiv' termina con sonido de v."},"target":"five","options":["four","five","one"],"correct":1},{"type":"listen_missing_word","meta":{"conceptId":"vocab.numbers.four_five","section":"produce","difficulty":1.3,"hint":"Cuenta las manzanas de Sam."},"audio":"I have four apples","options":["four","nine","two"],"correct":0},{"type":"who_said_it","meta":{"conceptId":"vocab.numbers.six_ten","section":"produce","difficulty":1.5,"hint":"Esta entre seis y diez."},"target":"seven","options":["six","seven","ten"],"correct":1},{"type":"listen_build","meta":{"conceptId":"vocab.numbers.four_five","section":"apply","difficulty":1.5,"tip":"Sam pide bloques para craftear."},"audio":"Give me five blocks","answer":["Give","me","five","blocks"],"prompt":"Sam necesita ingredientes. Arma su pedido."},{"type":"listen_build","meta":{"conceptId":"vocab.numbers.six_ten","section":"apply","difficulty":1.7,"tip":"Escucha cuantas abejas hay y arma la frase."},"audio":"I see eight bees","answer":["I","see","eight","bees"],"prompt":"Sam mira su colmena. Arma lo que dice."}]}},{"actId":"46006621-6bfe-4262-a875-eeb308d7457b","skill":"reading","title":"Reading · Colores y articulos","content":{"kind":"lesson","skill":"reading","contentVersion":2,"lives":false,"mixed":false,"present":{"title":"Colores de la pradera","intro":"Lia abre su Libro de Recetas en la pradera: hoy leemos los colores de los ingredientes y dos palabritas magicas, a/an y the.","theme":"recipe_book","items":[{"conceptId":"vocab.colors.red","headline":"Rojo, como el polvo de redstone","en":"red","es":"rojo","note":"red = rojo","icon":"redstone"},{"conceptId":"vocab.colors.blue","headline":"Azul, como el agua de la pradera","en":"blue","es":"azul","note":"blue = azul","icon":"water"},{"conceptId":"vocab.colors.green","headline":"Verde, como una esmeralda","en":"green","es":"verde","note":"green = verde","icon":"emerald"},{"conceptId":"vocab.colors.yellow","headline":"Amarillo, como una pepita de oro","en":"yellow","es":"amarillo","note":"yellow = amarillo","icon":"gold"},{"conceptId":"grammar.articles.a_an","headline":"a / an: para UN ingrediente cualquiera","en":"a / an","es":"un / una","note":"an antes de sonido de vocal: an apple","icon":"stone"}]},"exercises":[{"type":"match_pairs","meta":{"conceptId":"vocab.colors.red","section":"recognize","difficulty":1.1,"tip":"Une cada color en ingles con su color en espanol."},"pairs":[{"en":"red","es":"rojo"},{"en":"blue","es":"azul"},{"en":"green","es":"verde"},{"en":"yellow","es":"amarillo"}]},{"type":"text_mc","meta":{"conceptId":"vocab.colors.blue","section":"recognize","difficulty":1.1,"hint":"El agua siempre es blue."},"instruction":"Lee y elige el color del agua de la pradera.","prompt":"The water is...","options":["blue","green","red"],"correct":0},{"type":"text_mc","meta":{"conceptId":"vocab.colors.green","section":"recognize","difficulty":1.1,"hint":"La esmeralda brilla green."},"instruction":"Lee y elige el color de la esmeralda.","prompt":"The emerald is...","options":["green","yellow","blue"],"correct":0},{"type":"text_mc","meta":{"conceptId":"vocab.colors.yellow","section":"produce","difficulty":1.2,"hint":"El oro brilla yellow."},"instruction":"Lee y elige el color del oro de la mina.","prompt":"The gold is...","options":["yellow","red","green"],"correct":0},{"type":"text_mc","meta":{"conceptId":"grammar.articles.the","section":"produce","difficulty":1.7,"tip":"Usa the cuando hablas de algo que ya conoces o es unico."},"instruction":"Lia ya tiene SU esmeralda. Elige el articulo correcto.","prompt":"___ emerald is green.","options":["The","A","An"],"correct":0},{"type":"multi_select","meta":{"conceptId":"grammar.articles.a_an","section":"produce","difficulty":1.8,"tip":"an va antes de sonido de vocal (a, e, i, o, u)."},"prompt":"Marca TODAS las recetas escritas correctamente con a / an.","options":[{"text":"a pickaxe","correct":true},{"text":"an apple","correct":true},{"text":"an pickaxe","correct":false},{"text":"a apple","correct":false},{"text":"a torch","correct":true}]},{"type":"multi_select","meta":{"conceptId":"vocab.colors.green","section":"apply","difficulty":1.85,"hint":"Verde = pasto y esmeralda."},"prompt":"Lia junta ingredientes verdes. Marca TODO lo que es green.","options":[{"text":"emerald","correct":true},{"text":"grass","correct":true},{"text":"water","correct":false},{"text":"gold","correct":false}]},{"type":"text_mc","meta":{"conceptId":"grammar.articles.the","section":"apply","difficulty":1.9,"tip":"La segunda vez que mencionas algo, usa the."},"instruction":"El Sabio vio una abeja. Ahora habla de ESA misma abeja. Elige el articulo.","prompt":"I see a bee. ___ bee is yellow.","options":["The","A","An"],"correct":0},{"type":"text_mc","meta":{"conceptId":"grammar.articles.a_an","section":"apply","difficulty":1.95,"tip":"axe empieza con sonido de vocal: an axe."},"instruction":"Lia craftea una herramienta nueva. Elige a o an.","prompt":"Lia crafts ___ axe.","options":["an","a","the"],"correct":0}]}},{"actId":"118ce674-59a5-431e-9d21-eb01e7fb34f8","skill":"writing","title":"Writing · Familia y verbo to be","content":{"kind":"lesson","skill":"writing","contentVersion":2,"lives":false,"present":{"title":"Recetas de Familia","intro":"Lia te invita a su granja en la pradera: hoy escribimos los ingredientes de la familia y el verbo magico TO BE.","theme":"recipe_book","items":[{"conceptId":"vocab.family.mother","headline":"Asi se escribe 'madre'","en":"mother","es":"madre","note":"Empieza con m, como 'mama'.","icon":"plank"},{"conceptId":"vocab.family.father","headline":"Asi se escribe 'padre'","en":"father","es":"padre","note":"Empieza con f, como 'familia'.","icon":"plank"},{"conceptId":"vocab.family.brother_sister","headline":"Hermano y hermana","en":"brother / sister","es":"hermano / hermana","note":"brother = hermano, sister = hermana.","icon":"plank"},{"conceptId":"grammar.to_be.am","headline":"El TO BE para 'yo'","en":"I am","es":"yo soy / estoy","note":"Con 'I' siempre va 'am'.","icon":"wood"},{"conceptId":"grammar.to_be.is","headline":"El TO BE para el / ella","en":"he / she is","es":"el / ella es","note":"Con he, she, it va 'is'.","icon":"wood"}]},"exercises":[{"type":"fill_blank","meta":{"conceptId":"vocab.family.mother","section":"recognize","difficulty":1.3,"hint":"Es quien siembra el trigo: la madre.","tip":"mother = madre"},"before":"Lia says: My ","after":" grows wheat.","options":["mother","father","brother"],"correct":0},{"type":"fill_blank","meta":{"conceptId":"vocab.family.father","section":"recognize","difficulty":1.3,"hint":"El que pica la piedra: el padre.","tip":"father = padre"},"before":"My ","after":" mines stone.","options":["father","sister","mother"],"correct":0},{"type":"fill_blank","meta":{"conceptId":"vocab.family.brother_sister","section":"recognize","difficulty":1.5,"hint":"Un nino de tu familia: hermano.","tip":"brother = hermano"},"before":"My ","after":" plants seeds with me.","options":["brother","mother","father"],"correct":0},{"type":"word_bank","meta":{"conceptId":"grammar.to_be.am","section":"produce","difficulty":1.6,"tip":"Con 'I' siempre va 'am'."},"prompt":"Yo soy granjera.","answer":["I","am","a","farmer"]},{"type":"word_bank","meta":{"conceptId":"grammar.to_be.is","section":"produce","difficulty":1.7,"tip":"Con 'she' va 'is'."},"prompt":"Ella es mi madre.","answer":["She","is","my","mother"]},{"type":"word_bank","meta":{"conceptId":"grammar.to_be.are","section":"produce","difficulty":1.8,"tip":"Con 'they' va 'are'."},"prompt":"Ellos son mi familia.","answer":["They","are","my","family"]},{"type":"free_text","meta":{"conceptId":"grammar.to_be.is","section":"apply","difficulty":1.8,"hint":"he + is = el es.","tip":"Puedes escribir 'he is' o 'he's'."},"prompt":"Escribe en ingles: 'El es mi hermano.'","accept":["he is my brother","he's my brother"]},{"type":"free_text","meta":{"conceptId":"grammar.to_be.are","section":"apply","difficulty":1.9,"hint":"we + are = nosotros somos.","tip":"Recuerda 'we are'."},"prompt":"Escribe en ingles: 'Nosotros somos una familia.'","accept":["we are a family","we are family"]}]}},{"actId":"19fc5624-0828-4b99-9ee3-859145868993","skill":"speaking","title":"Speaking · Comida","content":{"kind":"lesson","skill":"speaking","contentVersion":2,"lives":false,"present":{"title":"La Receta de la Merienda","intro":"Sam el apicultor abre su Libro de Recetas en la pradera: estos son los ingredientes de comida que vamos a decir en voz alta.","theme":"recipe_book","items":[{"conceptId":"vocab.food.water","headline":"Agua para la pradera","en":"water","es":"agua","note":"Suena 'uo-ter'.","icon":"water"},{"conceptId":"vocab.food.bread","headline":"Pan recien forjado","en":"bread","es":"pan","note":"Suena 'bred'.","icon":"sand"},{"conceptId":"vocab.food.apple","headline":"Manzana de las hojas","en":"apple","es":"manzana","note":"Suena 'a-pel'.","icon":"leaves"},{"conceptId":"vocab.food.milk","headline":"Leche blanca como la nieve","en":"milk","es":"leche","note":"Suena 'milk'.","icon":"snow"}]},"exercises":[{"type":"speak_repeat","meta":{"conceptId":"vocab.food.water","section":"recognize","difficulty":1.1,"hint":"Junta los labios suave: 'uo-ter'.","tip":"water = agua"},"say":"water","prompt":"Sam llena su cantimplora. Repite con el: 'water'."},{"type":"speak_repeat","meta":{"conceptId":"vocab.food.bread","section":"recognize","difficulty":1.2,"hint":"Una sola silaba: 'bred'.","tip":"bread = pan"},"say":"bread","prompt":"Sam te muestra el pan de la receta. Repite: 'bread'."},{"type":"speak_repeat","meta":{"conceptId":"vocab.food.apple","section":"recognize","difficulty":1.2,"hint":"Abre la boca al inicio: 'A-pel'.","tip":"apple = manzana"},"say":"apple","prompt":"Cae una manzana de las hojas. Repite con Sam: 'apple'."},{"type":"speak","meta":{"conceptId":"vocab.food.milk","section":"produce","difficulty":1.2,"hint":"Blanca como la nieve.","tip":"milk = leche"},"say":"milk","prompt":"Di tu solo el nombre de la leche en ingles."},{"type":"speak","meta":{"conceptId":"vocab.food.apple","section":"produce","difficulty":1.2,"hint":"La fruta roja de la receta.","tip":"apple = manzana"},"say":"apple","prompt":"Di tu solo el nombre de la manzana en ingles."},{"type":"speak","meta":{"conceptId":"vocab.food.water","section":"produce","difficulty":1.2,"hint":"Lo que bebes en la pradera.","tip":"water = agua"},"say":"water","prompt":"Di tu solo el nombre del agua en ingles."},{"type":"speak_answer","meta":{"conceptId":"vocab.food.bread","section":"apply","difficulty":1.4,"hint":"Lo haces con trigo.","tip":"bread = pan"},"question":"What do you make with wheat?","accept":["bread"],"prompt":"Sam te pregunta que se hace con el trigo. Responde en ingles."},{"type":"speak_answer","meta":{"conceptId":"vocab.food.milk","section":"apply","difficulty":1.4,"hint":"La vaca te lo da, es blanco.","tip":"milk = leche"},"question":"What white drink comes from the cow?","accept":["milk"],"prompt":"La vaca de Sam da una bebida blanca. Responde en ingles."},{"type":"speak_answer","meta":{"conceptId":"vocab.food.apple","section":"apply","difficulty":1.4,"hint":"Es roja y crece en el arbol.","tip":"apple = manzana"},"question":"What red fruit do you eat?","accept":["apple"],"prompt":"Sam senala la fruta roja del arbol. Responde en ingles."}]}},{"actId":"e2e2a2df-9cb6-4a8b-a679-dab42e5a6d8f","skill":"pronunciation","title":"Pronunciation · Sonidos /th/ y /i/","content":{"kind":"lesson","skill":"pronunciation","contentVersion":2,"lives":false,"present":{"title":"Sonidos de la Pradera","intro":"Sam el apicultor calienta la forja: hoy afilamos dos sonidos como si fueran ingredientes brillantes.","theme":"recipe_book","items":[{"conceptId":"phoneme.th.voiceless","headline":"El sonido /th/ sordo: saca la lengua entre los dientes y sopla","en":"three","es":"tres","note":"Lengua entre los dientes, aire suave (sin voz).","icon":"diamond"},{"conceptId":"phoneme.th.voiceless","headline":"Mismo sonido /th/ para dar las gracias","en":"thanks","es":"gracias","note":"No digas 'tanks': la lengua asoma.","icon":"diamond"},{"conceptId":"phoneme.short_i","headline":"La vocal corta /i/: boca relajada y rapida","en":"it","es":"lo/eso","note":"Corta y suave, no como 'ee'.","icon":"coal"},{"conceptId":"phoneme.short_i","headline":"Misma /i/ corta al senalar algo cercano","en":"this","es":"esto/este","note":"El sonido del medio es corto: 'th-i-s'.","icon":"coal"}]},"exercises":[{"type":"minimal_pairs","meta":{"conceptId":"phoneme.short_i","section":"recognize","difficulty":1.6,"hint":"La /i/ corta es rapida; la otra suena alargada 'ee'.","tip":"sit = corta, seat = larga."},"audio":"sit","options":["sit","seat"],"correct":0,"ipa":["/sɪt/","/siːt/"]},{"type":"multi_select","meta":{"conceptId":"phoneme.short_i","section":"recognize","difficulty":1.6,"hint":"Busca la /i/ cortita como en 'it'."},"prompt":"Toca todas las palabras que tienen el sonido corto /i/ como en 'it'.","options":[{"text":"it","correct":true},{"text":"this","correct":true},{"text":"sit","correct":true},{"text":"eat","correct":false},{"text":"three","correct":false}]},{"type":"minimal_pairs","meta":{"conceptId":"phoneme.th.voiceless","section":"recognize","difficulty":1.9,"hint":"En 'three' la lengua asoma; en 'tree' la lengua se queda atras.","tip":"/th/ = aire entre los dientes."},"audio":"three","options":["three","tree","free"],"correct":0,"ipa":["/θriː/","/triː/","/friː/"]},{"type":"speak","meta":{"conceptId":"phoneme.short_i","section":"produce","difficulty":1.7,"hint":"Manten la boca relajada y la /i/ cortita.","tip":"Tres /i/ cortas seguidas."},"say":"This is it.","prompt":"Repite con Sam la /i/ corta tres veces: 'This is it.'"},{"type":"speak","meta":{"conceptId":"phoneme.th.voiceless","section":"produce","difficulty":1.9,"hint":"Saca un poquito la lengua entre los dientes al empezar.","tip":"No 'tank you', es 'thank you'."},"say":"Thank you.","prompt":"Di 'Thank you' a Sam sacando la lengua entre los dientes para el /th/."},{"type":"multi_select","meta":{"conceptId":"phoneme.th.voiceless","section":"apply","difficulty":2,"hint":"El /th/ sordo necesita la lengua entre los dientes, no detras."},"prompt":"Sam empaca mieles: toca solo las palabras que empiezan con el sonido /th/ (lengua entre los dientes).","options":[{"text":"three","correct":true},{"text":"thanks","correct":true},{"text":"think","correct":true},{"text":"tree","correct":false},{"text":"time","correct":false}]},{"type":"speak","meta":{"conceptId":"phoneme.th.voiceless","section":"apply","difficulty":2,"hint":"Cuida el /th/ en 'thanks' y en 'three': la lengua asoma entre los dientes y sopla suave.","tip":"Junta los sonidos en una frase real."},"say":"Thanks for the three jars.","prompt":"Agradece a Sam por tres frascos de miel: 'Thanks for the three jars.' Marca bien cada /th/."}]}},{"actId":"ae0b5f0f-793d-4281-b15d-137fbd90a371","skill":"conversation","title":"Conversacion · Saludos","content":{"kind":"lesson","skill":"conversation","contentVersion":2,"lives":false,"mixed":false,"present":{"title":"Recetas de Saludo","intro":"En la pradera, Lia te enseña las palabras mágicas para saludar a cada aldeano.","theme":"recipe_book","items":[{"conceptId":"func.greetings.hello","headline":"Para empezar una charla","en":"Hello! / Hi!","es":"¡Hola!","note":"Lo dices al llegar.","icon":"grass"},{"conceptId":"func.greetings.goodbye","headline":"Para despedirte","en":"Goodbye! / Bye!","es":"¡Adiós!","note":"Lo dices al irte.","icon":"grass"},{"conceptId":"func.courtesy.please_thanks","headline":"Palabras amables","en":"Please / Thank you","es":"Por favor / Gracias","note":"Pides con 'please', agradeces con 'thank you'.","icon":"grass"},{"conceptId":"func.greetings.how_are_you","headline":"Para preguntar cómo está","en":"How are you?","es":"¿Cómo estás?","note":"Responde: I am fine, thank you!","icon":"dirt"},{"conceptId":"func.greetings.my_name_is","headline":"Para decir tu nombre","en":"My name is...","es":"Me llamo...","note":"My name is + tu nombre.","icon":"dirt"}]},"exercises":[{"type":"dialogue","meta":{"conceptId":"func.greetings.hello","section":"recognize","difficulty":1,"hint":"Cuando un aldeano dice 'Hello', tú también dices 'Hello'."},"persona":"Aldeano","turns":[{"npc":"Hello!","options":[{"text":"Hello!","correct":true},{"text":"Goodbye!","correct":false},{"text":"Thank you!","correct":false}]},{"npc":"Hi there, friend!","options":[{"text":"Hi!","correct":true},{"text":"Bye!","correct":false},{"text":"Please.","correct":false}]},{"npc":"Hello! Welcome to the meadow!","options":[{"text":"Hello!","correct":true},{"text":"How are you... goodbye?","correct":false},{"text":"Thank you, bye!","correct":false}]}]},{"type":"dialogue","meta":{"conceptId":"func.greetings.goodbye","section":"recognize","difficulty":1.1,"hint":"Para despedirte usa 'Goodbye!' o 'Bye!'."},"persona":"Aldeano","turns":[{"npc":"I have to go now. Goodbye!","options":[{"text":"Goodbye!","correct":true},{"text":"Hello!","correct":false},{"text":"Please!","correct":false}]},{"npc":"See you tomorrow. Bye!","options":[{"text":"Bye!","correct":true},{"text":"Hi!","correct":false},{"text":"Thank you, hello!","correct":false}]},{"npc":"It is late. Goodbye, friend!","options":[{"text":"Goodbye!","correct":true},{"text":"Hello, friend!","correct":false},{"text":"My name is bye.","correct":false}]}]},{"type":"dialogue","meta":{"conceptId":"func.courtesy.please_thanks","section":"recognize","difficulty":1.2,"tip":"Pides con 'please' y agradeces con 'thank you'."},"persona":"Aldeano","turns":[{"npc":"Here is some honey for you.","options":[{"text":"Thank you!","correct":true},{"text":"Goodbye!","correct":false},{"text":"Hello!","correct":false}]},{"npc":"What do you want from the chest?","options":[{"text":"Honey, please.","correct":true},{"text":"Honey, goodbye.","correct":false},{"text":"Honey, hello.","correct":false}]},{"npc":"Thank you for your help!","options":[{"text":"You're welcome!","correct":true},{"text":"Goodbye, please!","correct":false},{"text":"Hello, thank you!